<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.0.0</version>
  <description>just bringup hardware for walkie</description>
  <maintainer email="armmy2530@todo.todo">armmy2530</maintainer>
  <license>TODO: License declaration</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <depend>std_msgs</depend>
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>omni_wheel_drive_controller</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>walkie_description</exec_depend>
  <exec_depend>walkie_tf</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>dual_laser_merger</exec_depend>
  <exec_depend>robot_self_filter</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>robot_navigation</exec_depend>
  <!-- mujoco_omnibot.launch.py also needs mujoco_ros2_control and the MuJoCo
       extension mujoco_3d_lidar (head 3D lidar), which the pixi environment
       provides. They are not declared so that rosdep does not install MuJoCo
       into the physical Docker image. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
